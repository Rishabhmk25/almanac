# Required
GROQ_API_KEY=    # LLM calls
TAVILY_API_KEY=     # web search and page reading

# Models (verify against Groq's current list; the server checks at startup)
MODEL=openai/gpt-oss-120b
FALLBACK_MODEL=llama-3.3-70b-versatile

# Server
HOST=127.0.0.1      # keep loopback; any other value requires ADMIN_TOKEN
PORT=3000
DATA_DIR=./data
# ADMIN_TOKEN=      # enables POST /api/import (bearer token); never sent to the browser

# Budgets (whole turn); defaults and reasons are in backend.md section 6
# MAX_ROUNDS=3
# MAX_QUERIES_PER_TURN=12
# MAX_READS=2
# DEADLINE_MS=25000

# Testing
# NOW_OVERRIDE=2026-11-12T10:30:00Z   # freeze "today" for date tests
# SEED_DEMO=1                          # opt-in demo history (labelled in the UI)
# FAULT=tavily_down                    # tavily_down | groq_429 | query_timeout
    