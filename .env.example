# Required
GEMINI_API_KEY=         # Primary LLM calls (gemini-3.6-flash)
TAVILY_API_KEY=         # Web search and page reading

# Optional / Fallback
NOMIC_API_KEY=          # Nomic Embed API (nomic-embed-text-v1.5) for semantic vector memory
GROQ_API_KEY=           # Optional fallback LLM provider

# Models (Gemini 3.6 Flash is primary; ultra-fast, multi-lingual, and powerful reasoning)
MODEL=gemini-3.6-flash
FALLBACK_MODEL=gemini-3.5-flash-lite

# Server
HOST=127.0.0.1          # loopback only
PORT=3000
DATA_DIR=./data
# ADMIN_TOKEN=          # bearer token for POST /api/import; never sent to the browser

# Budgets (whole turn)
# MAX_ROUNDS=2
# MAX_QUERIES_PER_TURN=10
# MAX_READS=2
# MAX_EVIDENCE_CHARS=12000
# DEADLINE_MS=60000
# RESERVE_FOR_ANSWER_MS=25000

# Testing
# NOW_OVERRIDE=2026-11-12T10:30:00Z   # freeze "today" for date tests
# SEED_DEMO=1                          # opt-in demo history (labelled in the UI)
# FAULT=tavily_down                    # tavily_down | gemini_429 | groq_429 | query_timeout
