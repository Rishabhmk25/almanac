    "better-sqlite3": "13.1.1",
    "chrono-node": "2.10.3",
    "dompurify": "3.4.17",
    "dotenv": "18.0.10",
    "groq-sdk": "1.6.0",
    "hono": "4.13.18",
    "marked": "18.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/dompurify": "3.0.5",
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
